<?xml version="1.0" encoding="utf-8"?>
<!--
  Gerege Template Platform V3.0
  Gerege Systems Development Team болон Claude AI хамтран бүтээв, 2026.

  Нэвтрэлт нь ЗӨВХӨН Gerege SSO бөгөөд бүхэлдээ платформын BFF-ээр (WebView)
  явна: native OIDC client, App2App deeplink, App Links БАЙХГҮЙ тул intent
  filter (VIEW/BROWSABLE) ч, custom scheme ч шаардлагагүй.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TemplateApp"
        android:usesCleartextTraffic="false">

        <!--
          Portrait-only — iOS клиенттэй ижил (UISupportedInterfaceOrientations).
          Хоёр дэлгэц (нэвтрэх · профайл) нь босоо байрлалд зориулагдсан тул
          lint-ийн эргэлтийн сануулгыг зориудаар үл хэрэгснэ.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.TemplateApp"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
