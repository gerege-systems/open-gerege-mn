{
  "name": "gerege-template-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Gerege Template Platform V3.0 — desktop бүрхүүл (Electron). Web аппыг 1:1-ээр ачаална.",
  "license": "MIT",
  "author": "Gerege Systems <info@gerege.mn>",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && node scripts/dev.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "icon": "bash scripts/make-icon.sh",
    "dist:mac": "npm run build && electron-builder --mac --publish never -c.mac.identity=null",
    "dist:mac:signed": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "pack": "npm run build && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "5.4.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
